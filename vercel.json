{
  "version": 2,
  "installCommand": "npm install --force",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
